{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-7xl mx-auto px-6 py-10">
    {# En-tête #}
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-900">
            Tableau de bord
        </h1>

        <p class="mt-1 text-sm text-slate-500">
            Vue d'ensemble de l'activité WacDo.
        </p>
    </div>


    {# Statistiques principales #}
    <section class="mb-8">

        <h2 class="mb-4 text-lg font-semibold text-slate-900">
            Vue générale
        </h2>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

            {# Restaurants #}
            <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm font-medium text-slate-500">
                    Restaurants
                </p>

                <p class="mt-2 text-3xl font-semibold text-slate-900">
                    {{ stats.restaurants }}
                </p>
            </div>


            {# Collaborateurs occupés #}
            <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm font-medium text-slate-500">
                    Collaborateurs affectés
                </p>

                <p class="mt-2 text-3xl font-semibold text-slate-900">
                    {{ stats.collaborators.busy }}
                </p>

                <p class="mt-1 text-xs text-slate-500">
                    Actuellement en poste
                </p>
                <div class="w-full max-w-2xl h-80">
                    <canvas
                    data-controller="chartjs"
                    data-chartjs-title-value="Répartitions des collaborateurs"
                    data-chartjs-total-value="{{stats.collaborators.total}}"
                    data-chartjs-part-value="{{stats.collaborators.busy}}"
                    data-chartjs-label-total-value="Collaborateurs totals"
                    data-chartjs-label-part-value="Collaborateurs actifs"

                    ></canvas>
                </div>
            </div>


            {# Collaborateurs disponibles #}
            <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm font-medium text-slate-500">
                    Collaborateurs disponibles
                </p>

                <p class="mt-2 text-3xl font-semibold text-green-600">
                    {{ stats.collaborators.available }}
                </p>

                <p class="mt-1 text-xs text-slate-500">
                    Sans affectation en cours
                </p>
                 <div class="w-full max-w-2xl h-80">
                    <canvas
                    data-controller="chartjs"
                    data-chartjs-labels-value='["Collaborateurs totals", "Collaborateurs disponibles"]'
                    data-chartjs-datasets-value='[{ "data":{ {{stats.collaborators.total}}, {{stats.collaborators.available}} } }]'
                    ></canvas>
                </div>
            </div>

        </div>

    </section>


    {# Affectations #}
    <section>

        <div class="mb-4 flex items-center justify-between">

            <h2 class="text-lg font-semibold text-slate-900">
                Affectations
            </h2>
        </div>


        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

            {# En attente #}
            <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-amber-200">

                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-slate-600">
                        En attente
                    </p>

                    <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                </div>

                <p class="mt-3 text-3xl font-semibold text-slate-900">
                    {{ stats.assignments.pending }}
                </p>

                <p class="mt-1 text-xs text-slate-500">
                    Affectations à venir
                </p>

            </div>


            {# En cours #}
            <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-green-200">

                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-slate-600">
                        En cours
                    </p>

                    <span class="h-2.5 w-2.5 rounded-full bg-blue-400"></span>
                </div>

                <p class="mt-3 text-3xl font-semibold text-slate-900">
                    {{ stats.assignments.current }}
                </p>

                <p class="mt-1 text-xs text-slate-500">
                    Affectations actives
                </p>

            </div>


            {# Terminées #}
            <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">

                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-slate-600">
                        Terminées
                    </p>

                    <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                </div>

                <p class="mt-3 text-3xl font-semibold text-slate-900">
                    {{ stats.assignments.finished }}
                </p>

                <p class="mt-1 text-xs text-slate-500">
                    Affectations passées
                </p>

            </div>

        </div>

    </section>
</div>
{% endblock %}
