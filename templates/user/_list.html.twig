<div class="bg-white rounded-xl shadow-sm ring-1 ring-slate-200 overflow-hidden p-2">

    <div class="overflow-x-auto">
        <table class="w-full text-left">

            <thead class="bg-slate-50 border-b border-slate-200">
                <tr class="text-sm text-slate-600">

                    <th class="px-5 py-3 font-semibold">
                        Nom
                    </th>

                    <th class="px-5 py-3 font-semibold">
                        Prénom
                    </th>

                    <th class="px-5 py-3 font-semibold">
                        Email
                    </th>

                    <th class="px-5 py-3 font-semibold">
                        Date de recrutement
                    </th>
                    {% if is_granted('ROLE_ADMIN') %}
                        <th class="px-5 py-3 font-semibold">
                            Date d'archivage
                        </th>
                    {% endif %}
                    <th class="px-5 py-3 font-semibold text-right">
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody class="divide-y divide-slate-200">

                {% for collaborator in dataProvider %}
                        {% include 'user/_rowList.html.twig'
                        with { item: collaborator } %}

                {% else %}

                    <tr>
                        <td
                            colspan="7"
                            class="px-5 py-10 text-center text-slate-500"
                        >
                            <i class="fa-solid fa-magnifying-glass mb-2"></i>

                            <p>
                                Aucune affectation ne correspond à votre recherche.
                            </p>
                        </td>
                    </tr>

                {% endfor %}

            </tbody>
        </table>
    </div>
</div>
