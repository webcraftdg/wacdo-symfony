{% extends 'templatesAdmin/layout.html.twig' %}
{% block page_title %}
    WacDo : Tableau de bord : Administration
{% endblock %}
{% block main %}
    <div class="row g-4 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <div class="text-muted small">
                                Utilisateurs
                            </div>

                            <div class="fs-2 fw-bold mt-1">
                                {{ statistics.users }}
                            </div>
                        </div>

                        <div class="fs-2 text-primary">
                            <i class="fas fa-users"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <div class="text-muted small">
                                Restaurants
                            </div>

                            <div class="fs-2 fw-bold mt-1">
                                {{ statistics.restaurants }}
                            </div>
                        </div>

                        <div class="fs-2 text-primary">
                            <i class="fas fa-utensils"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <div class="text-muted small">
                                Affectations actives
                            </div>

                            <div class="fs-2 fw-bold mt-1">
                                {{ statistics.assignments }}
                            </div>
                        </div>

                        <div class="fs-2 text-primary">
                            <i class="fas fa-calendar-check"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <div class="text-muted small">
                                Fonctions
                            </div>

                            <div class="fs-2 fw-bold mt-1">
                                {{ statistics.functions }}
                            </div>
                        </div>

                        <div class="fs-2 text-primary">
                            <i class="fas fa-briefcase"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    {{ include('templatesAdmin/dashboard/_assignment.html.twig', {
        title:'Affectations',
        subTitle:'Affectations en cours',
        assignments: inProgressAssignments
    })}}
    {# =========================================================
       PROCHAINES FINS D'AFFECTATION
       ========================================================= #}
    {{ include('templatesAdmin/dashboard/_assignment.html.twig', {
        title:'Prochaines affectations',
        subTitle:'Affectations en attente',
        assignments: upcomingAssignments
    })}}

    {# =========================================================
       DERNIÈRES AFFECTATIONS TERMINÉES
       ========================================================= #}
    {{ include('templatesAdmin/dashboard/_assignment.html.twig', {
        title:'Dernières affectations terminées',
        subTitle:'Derniers mouvements enregistrés',
        assignments: pastAssignments
    })}}
{% endblock %}
