{% extends 'base.html.twig' %}

{% block body %}

<div class="max-w-7xl mx-auto px-6 py-10">

    <div class=" flex justify-between mb-8 w-full">
        <div class="">
            <h1 class="text-2xl font-bold text-slate-900">Les affectations</h1>
            <p class="mt-1 text-slate-500">
                Consultez les affectations dans les restaurants.
            </p>
        </div>
        <div class="mt-6">
            {% if is_granted('ROLE_RESTAURANT_OWNER') %}
                <a href="{{ path('app_assignment_create') }}"
                    class="px-4 py-2 rounded-lg bg-blue-600
                        hover:bg-blue-700 text-white">
                    Créer
                </a>
            {% endif %}
        </div>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

        {% for assignment in assignments %}

                   {% include 'assigment/_article.html.twig'
                        with { assignment: assignment } %}

        {% else %}

            <div class="col-span-full text-center bg-white
                        rounded-xl ring-1 ring-slate-200 p-8
                        text-slate-500">

                Aucune affectation.

            </div>

        {% endfor %}

    </div>

</div>

{% endblock %}
