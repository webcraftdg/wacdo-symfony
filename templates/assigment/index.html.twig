{% extends 'base.html.twig' %}

{% block body %}

<div class="max-w-7xl mx-auto px-6 py-10">

    <div class=" flex justify-between mb-8 w-full">
        <div class="">
            <h1 class="text-2xl font-bold text-slate-900">Les affectations</h1>
            <p class="mt-1 text-slate-500">
                Consultez les affectations dans les restaurants.
            </p>
        </div>
        <div class="mt-6">
            {% if is_granted('ROLE_RESTAURANT_OWNER') %}
                <a href="{{ path('app_assignment_create') }}"
                    class="px-4 py-2 rounded-lg bg-blue-600
                        hover:bg-blue-700 text-white">
                    Créer
                </a>
            {% endif %}
        </div>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

        {% for assignment in assignments %}

            <article class="bg-white rounded-xl shadow-sm
                            ring-1 ring-slate-200 p-6 {{ assignment.status.borderClass }}">

                <div class="flex justify-between gap-4">

                    <h2 class="font-semibold text-lg text-slate-900">
                        {{ assignment.restaurant.name }}
                    </h2>

                    <span class="inline-flex items-center rounded-full px-2.5 py-1 text-md font-bold font-medium">
                        {{ assignment.status.label }}
                    </span>
                </div>

                <div class="mt-4">

                    <div class="font-medium text-slate-800">
                        {{ assignment.fonction.name }}
                    </div>

                    <div class="mt-2 text-sm text-slate-500">
                        Du {{ assignment.dateStart|date('d/m/Y') }}
                        au
                        {{ assignment.dateEnd
                            ? assignment.dateEnd|date('d/m/Y')
                            : '—'
                        }}
                    </div>

                </div>

                <div class="mt-4 text-sm text-slate-600">

                    <p>{{ assignment.restaurant.address }}</p>

                    <p>
                        {{ assignment.restaurant.zipCode }}
                        {{ assignment.restaurant.city }}
                    </p>

                </div>

                <div class="mt-6 flex justify-end">
                    {% if is_granted('ROLE_RESTAURANT_OWNER') %}
                        <a href="{{ path('app_assignment_update', {
                            id: assignment.id
                        }) }}"
                        class="px-4 py-2 rounded-lg bg-blue-600
                                hover:bg-blue-700 text-white">

                            &Eacute;diter
                        </a>
                    {% endif %}
                </div>

            </article>

        {% else %}

            <div class="col-span-full text-center bg-white
                        rounded-xl ring-1 ring-slate-200 p-8
                        text-slate-500">

                Aucune affectation.

            </div>

        {% endfor %}

    </div>

</div>

{% endblock %}
