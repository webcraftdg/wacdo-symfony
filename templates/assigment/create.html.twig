{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-3xl mx-auto px-6 py-10">

    <h1 class="text-2xl font-bold text-slate-900">
        Créer une affectation
    </h1>

    <div class="mt-8 bg-white rounded-xl shadow-sm
                ring-1 ring-slate-200 p-6"
                {% if addModelNewUser is true %}
                    data-controller="modal-create"
                    data-modal-create-url-value="{{ path('app_user_async_create') }}"
                {% endif %}
                >
                {% include 'common/_form-create-assignment.html.twig' with { form: form, addModelNewUser: addModelNewUser} %}
    </div>
</div>
{% endblock %}
