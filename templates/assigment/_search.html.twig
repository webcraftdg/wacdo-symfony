
   {{ form_start(form, {method:'GET', action:path('app_assignment_home'), class:'bg-white rounded-xl shadow-sm ring-1 ring-slate-200 p-5 mb-6'}) }}
        <div class="space-y-5">

            {{ form_row(form.user) }}
            {{ form_row(form.restaurant) }}
            {{ form_row(form.fonction) }}

            <div class="grid sm:grid-cols-3 gap-5">

                <div>
                    {{ form_row(form.dateStart) }}
                </div>

                <div class="sm:col-span-2">
                    {{ form_row(form.dateEnd) }}
                </div>
            </div>
        </div>
        <div class="mt-8 flex justify-start">
             <button
                type="submit"
                class="px-4 py-2 rounded-lg bg-blue-600
                    text-white font-medium
                    hover:bg-blue-700
                    focus:outline-none focus:ring-2
                    focus:ring-blue-500 focus:ring-offset-2">
                Rechercher
            </button>
        </div>

    {{ form_end(form) }}

