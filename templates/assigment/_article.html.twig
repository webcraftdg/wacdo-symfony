<article
    class="bg-white rounded-xl shadow-sm ring-1 ring-slate-200 p-6 {{ assignment.status.borderClass }}"
    data-controller="delete"
    data-delete-delete-url-value="{{ path('app_assignment_delete', {id: assignment.id}) }}"
    data-delete-context-name-value="{{ assignment.fonction.name ~ ' : ' ~ assignment.user}}">

    <div class="flex justify-between gap-4">

        <h2 class="font-semibold text-lg text-slate-900">
            {{ assignment.restaurant.name }}
        </h2>
        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-md font-bold font-medium">
            {{ assignment.status.label }}
        </span>
    </div>

    <div class="mt-4">

        <div class="font-medium text-slate-800">
            Collaborateur : {{ assignment.user }}
        </div>
        <div class="font-medium text-slate-800">
            Fonction : {{ assignment.fonction.name }}
        </div>
        <div class="mt-2 text-sm text-slate-500">
            Du {{ assignment.dateStart|date('d/m/Y') }}
            au
            {{ assignment.dateEnd
                ? assignment.dateEnd|date('d/m/Y')
                : '—'
            }}
        </div>

    </div>

    <div class="mt-4 text-sm text-slate-600">

        <p>{{ assignment.restaurant.address }}</p>

        <p>
            {{ assignment.restaurant.zipCode }}
            {{ assignment.restaurant.city }}
        </p>

    </div>

    <div class="mt-6 flex justify-end gap-3">
        {% if is_granted('ROLE_RESTAURANT_OWNER') %}
            <button type=button
                class="inline-flex items-center gap-2
                    px-4 py-2 rounded-lg border border-red-300
                    text-red-700 hover:bg-red-50"
                data-action="click->delete#confirmDelete"
                >
                <i class="fa-solid fa-trash"></i>
                Supprimer
            </button>
            <a
                href="{{ path('app_assignment_update', {id: assignment.id}) }}"
                class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white"
                data-turbo-prefetch="false">
                &Eacute;diter
            </a>
        {% endif %}
    </div>

</article>
