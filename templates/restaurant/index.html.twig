{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-7xl mx-auto px-6 py-10">

    <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-900">
            Les restaurants
        </h1>

        <p class="mt-1 text-slate-500">
            Consultez et gérez vos restaurants.
        </p>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

        {% for restaurant in restaurants %}

            <article class="bg-white rounded-xl shadow-sm
                            ring-1 ring-slate-200 p-6">

                <h2 class="text-lg font-semibold text-slate-900">
                    {{ restaurant.name }}
                </h2>

                <div class="mt-4 text-sm text-slate-600 space-y-1">

                    <p>{{ restaurant.address }}</p>

                    <p>
                        {{ restaurant.zipCode }}
                        {{ restaurant.city }}
                    </p>

                </div>

                <div class="mt-6 flex justify-end">

                    <a href="{{ path('app_restaurant_detail', {
                        id: restaurant.id
                    }) }}"
                       class="px-4 py-2 rounded-lg bg-blue-600
                              text-white text-sm font-medium
                              hover:bg-blue-700">

                        Voir

                    </a>

                </div>

            </article>

        {% else %}

            <div class="col-span-full bg-white rounded-xl
                        ring-1 ring-slate-200 p-8 text-center text-slate-500">

                Aucun restaurant.

            </div>

        {% endfor %}

    </div>
</div>
{% endblock %}
