{% extends 'base.html.twig' %}

{% block body %}
<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
   {% include 'common/_form-filter-generic.html.twig'
            with { form: searchForm } %}
    <div class="flex flex-col gap-2 mb-2 w-full
            md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Les restaurants</h1>
            <p class="mt-1 text-slate-500">
                Consultez et gérez vos restaurants.
            </p>
        </div>
        {% if (is_granted('ROLE_ADMIN')) %}
        <div class="md:w-auto md:flex-row md:items-center md:shrink-0">
            <div class="w-full md:w-auto">
                <a href="{{ path('app_restaurant_create') }}"
                    class="inline-flex w-full md:w-auto items-center justify-center
       rounded-lg bg-blue-600 px-4 py-2
       text-center text-white hover:bg-blue-700">
                    Créer
                </a>
            </div>
        </div>
        {% endif %}

    </div>
        {% include 'restaurant/_list.html.twig'
                    with { items: items } %}

</div>
{% endblock %}
