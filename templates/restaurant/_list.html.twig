<div class="bg-white rounded-xl shadow-sm ring-1 ring-slate-200 overflow-hidden p-2">

    <div class="overflow-x-auto">
        <table class="block w-full text-left md:table">

            <thead class="hidden md:table-header-group bg-slate-50 border-b border-slate-200">
                <tr class="text-sm text-slate-600">

                    <th class="px-5 py-3 font-semibold">
                        Restaurant
                    </th>

                    <th class="px-5 py-3 font-semibold">
                        Adresse
                    </th>

                    <th class="px-5 py-3 font-semibold">
                        Code postal
                    </th>

                    <th class="px-5 py-3 font-semibold">
                        Ville
                    </th>
            {% if is_granted('ROLE_ADMIN') %}
                    <th class="px-5 py-3 font-semibold">
                        Archivé le
                    </th>
            {% endif %}

                    {% if is_granted('ROLE_RESTAURANT_OWNER') %}
                        <th class="px-5 py-3 font-semibold text-right">
                            Actions
                        </th>
                    {% endif %}

                </tr>
            </thead>

            <tbody class="block space-y-3 md:table-row-group md:space-y-0 md:divide-y md:divide-slate-200">

                {% for item in dataProvider %}
                        {% include 'restaurant/_rowList.html.twig'
                        with { item: item } %}

                {% else %}

                    <tr class="block md:table-row">
                        <td
                            colspan="7"
                            class="block px-5 py-10 text-center text-slate-500 md:table-cell"
                        >
                            <i class="fa-solid fa-magnifying-glass mb-2"></i>

                            <p>
                                Aucun restaurant ne correspond à votre recherche.
                            </p>
                        </td>
                    </tr>

                {% endfor %}

            </tbody>
        </table>
    </div>
</div>
