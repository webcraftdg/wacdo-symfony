<article class=" relative bg-white rounded-xl shadow-sm
                    ring-1 ring-slate-200 p-6"
        data-controller="background"
        data-background-active-value="{{  restaurant.dateArchived is not null ? 'true' : 'false' }}"
        data-background-classes-value="opacity-50"
        >
    {% if restaurant.dateArchived is not null %}
        <span class="absolute top-4 right-4
                     px-3 py-1 rounded-full
                     bg-slate-200 text-slate-700
                     text-xs font-semibold">
            Archivé
        </span>
    {% endif %}

    <h2 class="text-lg font-semibold text-slate-900">
        {{ restaurant.name }}
    </h2>

    <div class="mt-4 text-sm text-slate-600 space-y-1">

        <p>{{ restaurant.address }}</p>

        <p>
            {{ restaurant.zipCode }}
            {{ restaurant.city }}
        </p>

    </div>

    <div class="mt-6 flex justify-end">

        <a href="{{ path('app_restaurant_detail', {
            id: restaurant.id
        }) }}"
            class="px-4 py-2 rounded-lg bg-blue-600
                    text-white text-sm font-medium
                    hover:bg-blue-700">

            Voir

        </a>

    </div>

</article>
