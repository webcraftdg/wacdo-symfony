<div data-controller="modal">

    <button
        type="button"
        class="px-4 py-2 rounded-lg bg-blue-600
                        text-white font-medium
                        hover:bg-blue-700
                        focus:outline-none focus:ring-2
                        focus:ring-blue-500 focus:ring-offset-2"
        data-action="modal#open">
        Filtrer
    </button>

    <div data-modal-target="modal" class="hidden fixed bg-gray-800 inset-0 flex items-center justify-center">
        {# fenêtre #}
        <div class="relative bg-white p-6 rounded shadow-lg text-center">
            <button
                type="button"
                class=" absolute top-0 right-0  p-2 m-2 rounded-lg bg-red-600
                                text-white font-medium
                                hover:bg-red-700
                                focus:outline-none focus:ring-2
                                focus:ring-red-500 focus:ring-offset-2"
                data-action="modal#close">
                <i data-controller="icon" data-icon-name-value="delete"></i>
            </button>
            {{ form_start(form, {
                method:'POST',
                class:'bg-white rounded-xl shadow-sm ring-1 ring-slate-200 p-5 mb-6',
                attr: {
                    'data-turbo': 'false'
                }}) }}

            <div class="grid {{ form.user is defined and form.restaurant is defined ? 'grid-cols-3 gap-4' : 'grid-cols-2 gap-3'}}">
                <div class="col-span-3">
                    {{ form_row(form.keyword) }}
                </div>
                {% if form.user is defined %}
                    {{ form_row(form.user) }}
                {% endif %}
                {% if form.restaurant is defined %}
                    {{ form_row(form.restaurant) }}
                {% endif %}
                {{ form_row(form.fonction) }}
            </div>
            <div class="grid sm:grid-cols-2 gap-3">
                <div>
                    {{ form_row(form.dateStart) }}
                </div>
                <div>
                    {{ form_row(form.dateEnd) }}
                </div>
            </div>
            <div class="mt-2 flex justify-start">
                <a href="{{ form.vars.action  }}" class="px-4 py-2 rounded-lg bg-red-600
                        text-white font-medium
                        mr-2
                        hover:bg-red-700
                        focus:outline-none focus:ring-2
                        focus:ring-red-500 focus:ring-offset-2">
                    Réinitialiser
                </a>
                <button
                    type="submit"
                    class="px-4 py-2 rounded-lg bg-blue-600
                        text-white font-medium
                        hover:bg-blue-700
                        focus:outline-none focus:ring-2
                        focus:ring-blue-500 focus:ring-offset-2">
                    Rechercher
                </button>
            </div>

        {{ form_end(form) }}
        </div>
    </div>
</div>

