
   {{ form_start(form) }}
        <div class="space-y-5">
           <div class="grid grid-cols-1 items-center gap-3
                {{ addModelNewUser is true ? 'md:grid-cols-2' : '' }}">
                {% if addModelNewUser is true %}
                    <div class="order-1 md:order-2">
                        <button
                            type="button"
                            class="w-full rounded-lg bg-blue-600 px-4 py-2
                                font-medium text-white
                                hover:bg-blue-700
                                focus:outline-none focus:ring-2
                                focus:ring-blue-500 focus:ring-offset-2"
                            data-action="modal-create#open">
                            Créer un collaborateur
                        </button>
                    </div>
                {% endif %}

                <div class="order-2 min-w-0 md:order-1">
                    {{ form_row(form.user) }}
                </div>

            </div>
            {{ form_row(form.restaurant) }}
            {{ form_row(form.fonction) }}

            <div class="grid sm:grid-cols-2 gap-5">
                {{ form_row(form.dateStart) }}
                {{ form_row(form.dateEnd) }}
            </div>
        </div>
        <div class="mt-8 flex justify-end">

            <button
                type="submit"
                class="px-4 py-2 rounded-lg bg-blue-600
                    text-white font-medium
                    hover:bg-blue-700
                    focus:outline-none focus:ring-2
                    focus:ring-blue-500 focus:ring-offset-2">

                Enregistrer
            </button>
        </div>
    {{ form_end(form) }}
{% if (addModelNewUser is true )%}
{{
    include('common/_modal-create.html.twig', {title:'Créer un collaborateur'})
}}
{% endif %}
