<header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

        {# Logo #}
        <a
            href="{{ path('app_home') }}"
            class="flex items-center gap-3"
        >
            <div class="flex h-10 w-10 items-center justify-center
                        rounded-xl bg-blue-600 text-lg font-bold text-white">
                W
            </div>

            <span class="text-xl font-bold tracking-tight text-slate-900">
                Wac<span class="text-blue-600">Do</span>
            </span>
        </a>
        {% if(is_granted('IS_AUTHENTICATED'))%}
            <nav class="flex items-center gap-6 text-sm font-medium">
                {% if is_granted('ROLE_RESTAURANT_OWNER') %}
                    <a href="{{ path('app_restaurant_home') }}"
                    class="text-slate-600 hover:text-blue-600 text-sm font-medium rounded-lg border border-slate-300 px-4 py-2 ">
                        Les restaurants
                    </a>
                {% endif %}

                {% if is_granted('ROLE_COLLAB') %}
                    <a href="{{ path('app_assignment_home') }}"
                    class="text-slate-600 hover:text-blue-600 text-sm font-medium rounded-lg border border-slate-300 px-4 py-2 ">
                        Les affectations
                    </a>
                {% endif %}
                 {% if is_granted('ROLE_RESTAURANT_OWNER') %}
                    <a href="{{ path('app_user_home') }}"
                    class="text-slate-600 hover:text-blue-600 text-sm font-medium rounded-lg border border-slate-300 px-4 py-2 ">
                        Les collaborateurs
                    </a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}"
                    class="text-slate-600 hover:text-blue-600 text-sm font-medium rounded-lg border border-slate-300 px-4 py-2 ">
                        Administration
                    </a>
                {% endif %}

                <a href="{{ path('app_account') }}"
                class="text-slate-600 hover:text-blue-600 text-sm font-medium rounded-lg border border-slate-300 px-4 py-2 ">
                    Mon compte
                </a>
            </nav>
        {% endif %}
        {# Utilisateur connecté #}
        {% if app.user %}
            <div class="flex items-center gap-6">

                <div class="flex items-center gap-3">

                    {# Icône utilisateur #}
                    <div class="flex h-9 w-9 items-center justify-center
                                rounded-full bg-slate-100 text-slate-600">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="h-5 w-5"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M15.75 6a3.75 3.75 0 1 1-7.5 0
                                   3.75 3.75 0 0 1 7.5 0ZM4.5
                                   20.118a7.5 7.5 0 0 1 15 0
                                   A17.933 17.933 0 0 1 12
                                   21.75c-2.676 0-5.216-.584-7.5-1.632Z"
                            />
                        </svg>

                    </div>

                    <div class="text-sm">
                        <div class="text-slate-500">
                            Connecté
                        </div>

                        <div class="font-medium text-slate-900">
                            {{ app.user.userIdentifier }}
                        </div>
                    </div>

                </div>

                <a
                    href="{{ path('app_logout') }}"
                    class="rounded-lg border border-slate-300 bg-white
                           px-4 py-2 text-sm font-medium text-slate-700
                           transition hover:bg-slate-50
                           focus:outline-none focus:ring-2
                           focus:ring-blue-500 focus:ring-offset-2"
                >
                    Déconnexion
                </a>

            </div>
        {% endif %}

    </div>
</header>
